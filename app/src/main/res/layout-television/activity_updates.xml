<!-- HavocOOS: Enhanced Glassmorphic TV Activity Layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    android:weightSum="2"
    android:baselineAligned="false"
    android:background="@android:color/transparent">

    <!-- HavocOOS: Enhanced Glassmorphic Header Container -->
    <RelativeLayout
        android:id="@+id/header_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_gravity="start"
        android:background="@drawable/glassmorphic_card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:paddingBottom="16dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="56sp"
                android:letterSpacing="-0.02"
                tools:text="HavocOOS\n1.0" />

            <TextView
                android:id="@+id/header_build_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/havoc_accent"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Android 15"/>

            <TextView
                android:id="@+id/header_build_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                tools:text="Build: 2026-02-23"/>

            <TextView
                android:id="@+id/header_last_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/havoc_accent"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Last checked: 2026-02-23"/>

        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:weightSum="2"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refresh"
                android:drawableStart="@drawable/ic_menu_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/menu_refresh"
                android:background="@drawable/glassmorphic_button_bg"
                android:textColor="@color/havoc_accent"/>

            <Button
                android:id="@+id/preferences"
                android:drawableStart="@drawable/ic_menu_preferences"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/menu_preferences"
                android:background="@drawable/glassmorphic_button_bg"
                android:textColor="@color/havoc_accent"/>

        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:layout_gravity="end">

        <!-- HavocOOS: Enhanced Glassmorphic No Updates View -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/no_new_updates_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="46dp"
            android:background="@drawable/glassmorphic_card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/list_no_updates"
                android:textColor="?android:textColorSecondary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"/>
        </androidx.core.widget.NestedScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="5dp"
            android:scrollbars="vertical"
            android:layout_gravity="end"
            tools:listitem="@layout/update_item_view"/>

        <ProgressBar
            android:id="@+id/refresh_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:visibility="gone"
            android:indeterminateTint="@color/havoc_accent"/>

    </RelativeLayout>
</LinearLayout>
