<!-- HavocOOS Enhanced Glassmorphic Button Background with Premium Effects -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/havoc_ripple">
    
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    
    <item>
        <layer-list>
            <!-- Layer 1: Base gradient for depth -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#20FFFFFF"
                        android:centerColor="#12FFFFFF"
                        android:endColor="#08FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Layer 2: Primary glass surface -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#38FFFFFF"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Layer 3: Top highlight for glass reflection -->
            <item
                android:top="0dp"
                android:bottom="24dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#45FFFFFF"
                        android:centerColor="#15FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Layer 4: Accent tint overlay -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#10FF8A65"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Layer 5: Primary border with accent -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="20dp"/>
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/havoc_accent"/>
                </shape>
            </item>
            
            <!-- Layer 6: Inner glow border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="20dp"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="#40FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
